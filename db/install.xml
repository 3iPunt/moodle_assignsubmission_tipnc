<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/assign/submission/tipnc/db" VERSION="20120423" COMMENT="XMLDB file for Moodle mod/assign/submission/tipnc"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../../../lib/xmldb/xmldb.xsd"
>
    <TABLES>
        <TABLE NAME="assignsubmission_tipnc" COMMENT="Info about Next Cloud submissions for assignments">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="assignment" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="submission" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="ncid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="path" TYPE="char" LENGTH="1333" NOTNULL="false" SEQUENCE="false" COMMENT="Where the document really is in NextCloud: renaming a course must not move it"/>
                <FIELD NAME="editorkey" TYPE="char" LENGTH="32" NOTNULL="false" SEQUENCE="false" COMMENT="Key of the editing session: stable while the document is open"/>
                <FIELD NAME="editorversion" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="State of the document when the key was minted"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="The unique id for this submission info."/>
                <KEY NAME="assignment" TYPE="foreign" FIELDS="assignment" REFTABLE="assign" REFFIELDS="id" COMMENT="The assignment instance this submission relates to"/>
                <KEY NAME="submission" TYPE="foreign" FIELDS="submission" REFTABLE="assign_submission" REFFIELDS="id" COMMENT="The submission this file submission relates to."/>
            </KEYS>
        </TABLE>
        <TABLE NAME="assignsubmission_tipnc_open" COMMENT="Document Next Cloud open assign (Not submitted) for submission assignment">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="assignment" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="submission" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="ncid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="path" TYPE="char" LENGTH="1333" NOTNULL="false" SEQUENCE="false" COMMENT="Where the document really is in NextCloud: renaming a course must not move it"/>
                <FIELD NAME="editorkey" TYPE="char" LENGTH="32" NOTNULL="false" SEQUENCE="false" COMMENT="Key of the editing session: stable while the document is open"/>
                <FIELD NAME="editorversion" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="State of the document when the key was minted"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="The unique id for this tipnc open info."/>
                <KEY NAME="assignment" TYPE="foreign" FIELDS="assignment" REFTABLE="assign" REFFIELDS="id" COMMENT="The assignment instance this submission relates to"/>
                <KEY NAME="submission" TYPE="foreign" FIELDS="submission" REFTABLE="assign_submission" REFFIELDS="id" COMMENT="The submission this file submission relates to."/>
            </KEYS>
        </TABLE>
        <TABLE NAME="assignsubmission_tipnc_enun" COMMENT="Enunciate Next Cloud submissions for assignments">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="assignment" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="ncid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="path" TYPE="char" LENGTH="1333" NOTNULL="false" SEQUENCE="false" COMMENT="Where the document really is in NextCloud: renaming a course must not move it"/>
                <FIELD NAME="editorkey" TYPE="char" LENGTH="32" NOTNULL="false" SEQUENCE="false" COMMENT="Key of the editing session: stable while the document is open"/>
                <FIELD NAME="editorversion" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="State of the document when the key was minted"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="The unique id for this enun info."/>
                <KEY NAME="assignment" TYPE="foreign" FIELDS="assignment" REFTABLE="assign" REFFIELDS="id" COMMENT="The assignment instance this submission relates to"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="assignsubmission_tipnc_log" COMMENT="Incident log of the calls made to NextCloud">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="severity" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="error" SEQUENCE="false" COMMENT="error, warning or info"/>
                <FIELD NAME="traceid" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false" COMMENT="Groups every call of a single user action"/>
                <FIELD NAME="operation" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Domain operation being attempted"/>
                <FIELD NAME="method" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Point in the code"/>
                <FIELD NAME="errorcode" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="assignment" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="submission" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Who ran the operation"/>
                <FIELD NAME="affecteduserid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Who the operation is about, when it differs"/>
                <FIELD NAME="httpmethod" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="requesturl" TYPE="char" LENGTH="1333" NOTNULL="false" SEQUENCE="false" COMMENT="Full URL, never with credentials"/>
                <FIELD NAME="httpcode" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Milliseconds"/>
                <FIELD NAME="documentpath" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="responsebody" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Trimmed and masked response body"/>
                <FIELD NAME="occurrences" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="firstseen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="lastseen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="The unique id for this incident."/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="lastseen" UNIQUE="false" FIELDS="lastseen" COMMENT="Default ordering and purge."/>
                <INDEX NAME="severity-lastseen" UNIQUE="false" FIELDS="severity, lastseen"/>
                <INDEX NAME="assignment" UNIQUE="false" FIELDS="assignment"/>
                <INDEX NAME="traceid" UNIQUE="false" FIELDS="traceid" COMMENT="Retrieves every call of one action."/>
                <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
                <INDEX NAME="dedupe" UNIQUE="false" FIELDS="errorcode, method, assignment, userid" COMMENT="Looks up an equivalent recent entry to group repetitions."/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
