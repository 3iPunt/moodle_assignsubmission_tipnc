{{!
    @template assignsubmission_tipnc/incident_list

    Listing of incidents. Repainted on its own when the filters change.

    Context variables required for this template:
    * incidents - the rows
    * summary - which incidents are being shown
    * pagination - the pages

    Example context (json):
    {
        "hasincidents": false,
        "isempty": true,
        "isfiltered": false,
        "emptyingood": true,
        "summary": ""
    }
}}
{{#hasincidents}}
    <p class="tipnc-log__summary" aria-live="polite">{{summary}}</p>
    <div class="table-responsive">
        <table class="tipnc-log__table table-reboot">
            <caption class="sr-only">{{#str}} log_title, assignsubmission_tipnc {{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} log_col_severity, assignsubmission_tipnc {{/str}}</th>
                    <th scope="col" class="tipnc-log__th--sorted">{{#str}} log_col_when, assignsubmission_tipnc {{/str}} &darr;</th>
                    <th scope="col">{{#str}} log_col_operation, assignsubmission_tipnc {{/str}}</th>
                    <th scope="col">{{#str}} log_col_where, assignsubmission_tipnc {{/str}}</th>
                    <th scope="col">{{#str}} log_col_who, assignsubmission_tipnc {{/str}}</th>
                    <th scope="col">{{#str}} log_col_answer, assignsubmission_tipnc {{/str}}</th>
                    <th scope="col">{{#str}} log_col_code, assignsubmission_tipnc {{/str}}</th>
                    <th scope="col"><span class="sr-only">{{#str}} log_col_actions, assignsubmission_tipnc {{/str}}</span></th>
                </tr>
            </thead>
            <tbody>
                {{#incidents}}
                    <tr class="{{#repeated}}tipnc-log__row--repeated{{/repeated}}">
                        <td>
                            <span class="tipnc-badge tipnc-badge--{{severity}}">
                                {{! Icono de estado: la severidad nunca se comunica solo con color. }}
                                {{#iserror}}
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg>
                                {{/iserror}}
                                {{#iswarning}}
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
                                {{/iswarning}}
                                {{#isinfo}}
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
                                {{/isinfo}}
                                {{severitylabel}}
                            </span>
                        </td>
                        <td class="tipnc-log__nowrap">
                            <span class="tipnc-log__when" title="{{whenexact}}">{{when}}</span>
                            {{#repeated}}
                                <div class="tipnc-log__meta">{{#str}} log_since, assignsubmission_tipnc, {{since}} {{/str}}</div>
                            {{/repeated}}
                        </td>
                        <td>
                            <div class="tipnc-log__opline">
                                <span class="tipnc-log__operation">{{operation}}</span>
                                {{#repeated}}
                                    <button type="button" class="tipnc-log__count" data-action="detail" data-id="{{id}}"
                                            title="{{#str}} log_repetitions, assignsubmission_tipnc {{/str}}">&times;{{occurrences}}</button>
                                {{/repeated}}
                            </div>
                            <div class="tipnc-log__code">{{method}}</div>
                        </td>
                        <td>
                            {{#assignmentname}}
                                {{#assignmenturl}}<a class="tipnc-log__link" href="{{assignmenturl}}">{{assignmentname}}</a>{{/assignmenturl}}
                                {{^assignmenturl}}<span class="tipnc-log__link">{{assignmentname}}</span>{{/assignmenturl}}
                                <div class="tipnc-log__sub"><a href="{{courseurl}}">{{coursename}}</a></div>
                            {{/assignmentname}}
                            {{^assignmentname}}&mdash;{{/assignmentname}}
                        </td>
                        <td>
                            {{#username}}<a class="tipnc-log__person" href="{{userurl}}">{{username}}</a>{{/username}}
                            {{^username}}&mdash;{{/username}}
                            {{#affectedname}}
                                <div class="tipnc-log__sub">&rarr; {{affectedname}}</div>
                            {{/affectedname}}
                        </td>
                        <td>
                            <span class="tipnc-log__http {{#httpok}}tipnc-log__http--ok{{/httpok}}{{^httpok}}{{#hashttpcode}}tipnc-log__http--ko{{/hashttpcode}}{{/httpok}}">{{httpcode}}</span>
                        </td>
                        <td>
                            <span class="tipnc-log__errorcode">{{errorcode}}</span>
                            <div class="tipnc-log__sub">{{errorlabel}}</div>
                        </td>
                        <td class="tipnc-log__actions">
                            <button type="button" class="tipnc-log__detail" data-action="detail" data-id="{{id}}">
                                {{#str}} log_detail, assignsubmission_tipnc {{/str}}
                            </button>
                        </td>
                    </tr>
                {{/incidents}}
            </tbody>
        </table>
    </div>

    {{#pagination.0}}
        <nav class="tipnc-log__pages" aria-label="{{#str}} log_pages, assignsubmission_tipnc {{/str}}">
            {{#pagination}}
                {{#current}}<span class="tipnc-log__page tipnc-log__page--current">{{number}}</span>{{/current}}
                {{^current}}
                    <button type="button" class="tipnc-log__page" data-action="page" data-page="{{page}}">{{number}}</button>
                {{/current}}
            {{/pagination}}
        </nav>
    {{/pagination.0}}
{{/hasincidents}}

{{#isempty}}
    <div class="tipnc-log__empty">
        {{#isfiltered}}
            <p class="tipnc-log__empty-title">{{#str}} log_empty_filtered, assignsubmission_tipnc {{/str}}</p>
            <button type="button" class="tipnc-log__action" data-action="clear">
                {{#str}} log_clearfilters, assignsubmission_tipnc {{/str}}
            </button>
        {{/isfiltered}}
        {{^isfiltered}}
            <p class="tipnc-log__empty-title">{{#str}} log_empty, assignsubmission_tipnc {{/str}}</p>
            {{#emptyingood}}
                <p class="tipnc-log__empty-good">{{#str}} log_empty_good, assignsubmission_tipnc {{/str}}</p>
            {{/emptyingood}}
        {{/isfiltered}}
    </div>
{{/isempty}}
