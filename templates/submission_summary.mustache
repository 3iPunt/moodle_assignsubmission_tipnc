{{!
    @template assignsubmission_tipnc/submission_summary

    The document of a submission, inside the submission status box.

    Shown when it is the person's own work on their own page; described and
    linked when the box is one cell among many.

    Context variables required for this template:
    * state - draft, submitted or enun
    * embed - whether the document is shown
    * label - what this document is
    * hint - what happens with it
    * url - where it is read
    * action - text of the link

    Example context (json):
    {
        "state": "submitted",
        "embed": true,
        "isdraft": false,
        "issubmitted": true,
        "label": "Entregado",
        "hint": "Copia guardada al entregar.",
        "url": "https://nextcloud.example.org/apps/onlyoffice/661",
        "action": "Abrir la entrega",
        "frametitle": "Entregado",
        "filename": "subm_36_alumno1.docx",
        "hasfilename": true,
        "modified": "Último cambio: 8/09/26, 16:21",
        "hasmodified": true
    }
}}
<div class="tipnc-subm tipnc-subm--{{state}}" data-region="assignsubmission_tipnc">

    <div class="tipnc-subm__head">
        <div class="tipnc-subm__body">
            <h3 class="tipnc-subm__title">{{title}}</h3>

            <span class="tipnc-subm__state">
                {{#isdraft}}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                    </svg>
                {{/isdraft}}
                {{#issubmitted}}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5"></path>
                    </svg>
                {{/issubmitted}}
                {{label}}
            </span>

            <p class="tipnc-subm__hint">{{hint}}</p>

            <p class="tipnc-subm__meta">
                {{#hasfilename}}<span class="tipnc-subm__file">{{filename}}</span>{{/hasfilename}}
                {{#hasmodified}}<span class="tipnc-subm__modified">{{modified}}</span>{{/hasmodified}}
            </p>
        </div>

        <div class="tipnc-subm__actions">
            <a class="tipnc-subm__action" href="{{url}}" target="_blank" rel="noopener">
                {{action}}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7"></path>
                    <path d="M9 7h8v8"></path>
                </svg>
            </a>
        </div>
    </div>

    {{#embed}}
        <div class="tipnc-viewer" data-region="tipnc-viewer">
            <div class="tipnc-frame__bar">
                {{! El motivo lo decide el visor; aquí solo se pinta, junto al resto
                de lo que se dice sobre este documento. }}
                {{#viewer.isreadonly}}
                    <p class="tipnc-frame__readonly">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        {{viewer.readonlytext}}
                    </p>
                {{/viewer.isreadonly}}
                <button type="button" class="tipnc-frame__full" data-action="tipnc-fullscreen">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M8 3H5a2 2 0 0 0-2 2v3"></path>
                        <path d="M16 3h3a2 2 0 0 1 2 2v3"></path>
                        <path d="M8 21H5a2 2 0 0 1-2-2v-3"></path>
                        <path d="M16 21h3a2 2 0 0 0 2-2v-3"></path>
                    </svg>
                    {{#str}} fullscreen, assignsubmission_tipnc {{/str}}
                </button>
            </div>
            {{#viewer}}
                {{> assignsubmission_tipnc/document_viewer }}
            {{/viewer}}
        </div>
    {{/embed}}

</div>
{{#embed}}
    {{#js}}
        require(['assignsubmission_tipnc/fullscreen'], function(fullscreen) {
            fullscreen.init();
        });
    {{/js}}
{{/embed}}
