{{!
    @template assignsubmission_tipnc/purge_confirm

    Body of the confirmation asked before emptying the incident log.

    Context variables required for this template:
    * total - how many incidents will be deleted

    Example context (json):
    {
        "total": 35
    }
}}
<div class="tipnc-confirm">
    {{! Destructive action: the icon announces it before a word is read. }}
    <div class="tipnc-confirm__icon tipnc-confirm__icon--danger">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6h18"></path>
            <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"></path>
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
        </svg>
    </div>

    <p class="tipnc-confirm__lead">
        {{#str}} purge_confirm, assignsubmission_tipnc, {{total}} {{/str}}
    </p>

    <p class="tipnc-confirm__hint">
        {{#str}} purge_hint, assignsubmission_tipnc {{/str}}
    </p>
</div>
