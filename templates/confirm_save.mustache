{{!
    @template assignsubmission_tipnc/confirm_save

    Confirmation that the document is saved, shown before submitting.

    It is printed hidden and the module moves it next to the submit button: on
    its own, at the top of the page, nobody would read it.

    Example context (json):
    {}
}}
<div class="tipnc-confirmsave" data-region="tipnc-confirmsave" hidden>
    <p class="tipnc-confirmsave__title">{{#str}} confirmsaved_title, assignsubmission_tipnc {{/str}}</p>

    {{! With no drafts, the form button submits: the name the core gives it
        —"Save changes"— does not say so, so it is said here. }}
    {{#alsosubmits}}
        <p class="tipnc-confirmsave__warning">
            {{#str}} confirmsaved_alsosubmits, assignsubmission_tipnc {{/str}}
        </p>
    {{/alsosubmits}}

    <p class="tipnc-confirmsave__hint">
        {{#cansave}}{{#str}} confirmsaved_hint_save, assignsubmission_tipnc {{/str}}{{/cansave}}
        {{^cansave}}{{#str}} confirmsaved_hint, assignsubmission_tipnc {{/str}}{{/cansave}}
    </p>

    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="tipnc-confirmsave"
               data-action="tipnc-confirmsave">
        <label class="form-check-label" for="tipnc-confirmsave">
            {{#str}} confirmsaved_label, assignsubmission_tipnc {{/str}}
        </label>
    </div>
</div>
