# El código se guarda con finales de línea LF, se clone donde se clone. Sin esto,
# un clon en Windows con core.autocrlf=true convierte todo a CRLF y el siguiente
# commit aparece como si hubieran cambiado los 102 ficheros.
* text=auto eol=lf

*.php       text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.mustache  text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.svg       text eol=lf

*.png       binary
*.jpg       binary
*.gif       binary
*.docx      binary

# Fuera de los archivos que se descarguen del repositorio.
.gitattributes  export-ignore
.gitignore      export-ignore
